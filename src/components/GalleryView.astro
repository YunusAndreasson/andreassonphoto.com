---
import { composeRows, type GalleryImage } from '../utils/composeRows';

interface Props {
  images: GalleryImage[];
}

const { images } = Astro.props;
const rows = composeRows(images);
---

<main class="gallery-wall">
  {rows.map((row, ri) =>
    row.map((cell) => {
      const img = cell.img;
      const src = `/gallery_bw/${img.file}`;
      const isEarly = ri < 3;
      return (
        <div
          class={`gallery-item gi-span-${cell.span}`}
          data-tone={img.tone}
          role="button"
          tabindex="0"
        >
          <img
            src={src}
            alt=""
            width={img.width}
            height={img.height}
            loading={isEarly ? 'eager' : 'lazy'}
            decoding={isEarly ? 'sync' : 'async'}
            fetchpriority={isEarly ? 'high' : undefined}
          />
        </div>
      );
    })
  )}
</main>

<dialog class="detail-overlay" aria-label="Image view">
  <div class="detail-image-wrap">
    <button class="detail-nav-prev" id="detail-prev" aria-label="Previous image" type="button"></button>
    <img id="detail-img" src="" alt="" />
    <button class="detail-nav-next" id="detail-next" aria-label="Next image" type="button"></button>
  </div>
  <div class="detail-counter" id="detail-counter"></div>
</dialog>

<script>
  const toneBg: Record<string, string> = {
    light: 'var(--detail-light)',
    dark: 'var(--detail-dark)',
    mid: 'var(--detail-mid)',
  };

  let controller: AbortController;

  document.addEventListener('astro:page-load', () => {
    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;

    const wall = document.querySelector<HTMLElement>('.gallery-wall');
    const overlay = document.querySelector<HTMLDialogElement>('.detail-overlay');
    if (!wall || !overlay) return;

    const detailImg = document.getElementById('detail-img') as HTMLImageElement;
    const detailCounter = document.getElementById('detail-counter')!;

    const galleryItems = wall.querySelectorAll<HTMLElement>('.gallery-item');
    const itemIndex = new Map<Element, number>();
    const navList: { tone: string; src: string }[] = [];

    for (const [i, el] of galleryItems.entries()) {
      itemIndex.set(el, i);
      navList.push({
        tone: el.dataset.tone!,
        src: el.querySelector('img')!.src,
      });
    }

    let currentNav = 0;

    function preloadAdjacent() {
      const prev = (currentNav - 1 + navList.length) % navList.length;
      const next = (currentNav + 1) % navList.length;
      new Image().src = navList[prev].src;
      new Image().src = navList[next].src;
    }

    function showImage(data: (typeof navList)[number]) {
      detailImg.classList.remove('is-loaded');

      overlay.classList.toggle('tone-light', data.tone === 'light');
      overlay.style.backgroundColor = toneBg[data.tone] ?? toneBg.mid;

      detailImg.src = data.src;
      detailImg.addEventListener('load', () => {
        detailImg.classList.add('is-loaded');
        preloadAdjacent();
      }, { once: true });
      if (detailImg.complete) {
        detailImg.classList.add('is-loaded');
        preloadAdjacent();
      }

      detailCounter.textContent = `${currentNav + 1}\u2009/\u2009${navList.length}`;
    }

    function navigate(dir: number) {
      currentNav = (currentNav + dir + navList.length) % navList.length;
      showImage(navList[currentNav]);
    }

    function openDetail(idx: number) {
      currentNav = idx;
      showImage(navList[currentNav]);
      overlay.showModal();
      document.body.style.overflow = 'hidden';
    }

    // Event delegation: single click + keydown on the gallery wall
    wall.addEventListener('click', (e) => {
      const item = (e.target as HTMLElement).closest('.gallery-item');
      if (!item) return;
      const idx = itemIndex.get(item);
      if (idx !== undefined) openDetail(idx);
    }, { signal });

    wall.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter' && e.key !== ' ') return;
      const item = (e.target as HTMLElement).closest('.gallery-item');
      if (!item) return;
      const idx = itemIndex.get(item);
      if (idx !== undefined) {
        e.preventDefault();
        openDetail(idx);
      }
    }, { signal });

    // Dialog close cleanup
    overlay.addEventListener('close', () => {
      document.body.style.overflow = '';
    }, { signal });

    // Nav buttons
    document.getElementById('detail-prev')!.addEventListener('click', (e) => {
      e.stopPropagation();
      navigate(-1);
    }, { signal });

    document.getElementById('detail-next')!.addEventListener('click', (e) => {
      e.stopPropagation();
      navigate(1);
    }, { signal });

    // Click backdrop to close
    overlay.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target === overlay || target.classList.contains('detail-image-wrap')) {
        overlay.close();
      }
    }, { signal });

    // Arrow key navigation
    document.addEventListener('keydown', (e) => {
      if (!overlay.open) return;
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') navigate(1);
      if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') navigate(-1);
    }, { signal });

    // Swipe gestures
    let startX = 0;
    let startY = 0;

    overlay.addEventListener('pointerdown', (e) => {
      startX = e.clientX;
      startY = e.clientY;
    }, { passive: true, signal });

    overlay.addEventListener('pointerup', (e) => {
      const dx = e.clientX - startX;
      const dy = e.clientY - startY;
      if (Math.abs(dx) > Math.abs(dy) && Math.abs(dx) > 50) {
        navigate(dx < 0 ? 1 : -1);
      } else if (Math.abs(dy) > 80) {
        overlay.close();
      }
    }, { passive: true, signal });
  });
</script>
