---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { composeRows, type GalleryImage } from '../utils/composeRows';

interface Props {
  images: GalleryImage[];
}

const { images } = Astro.props;
const rows = composeRows(images);

// Optimized binaries, resolved by filename from the gallery asset folder.
const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/gallery_bw/*.{jpg,jpeg}',
);

// `sizes` per grid span so each image downloads at its real rendered width.
// Container is max-width:1200px / 12-col; spans collapse to 2-col (≤768px)
// then 1-col (≤480px) — see global.css.
const SPAN_SIZES: Record<number, string> = {
  12: '(max-width: 768px) 100vw, 1200px',
  7: '(max-width: 480px) 100vw, (max-width: 768px) 50vw, 680px',
  6: '(max-width: 480px) 100vw, (max-width: 768px) 50vw, 580px',
  5: '(max-width: 480px) 100vw, (max-width: 768px) 50vw, 480px',
  4: '(max-width: 480px) 100vw, (max-width: 768px) 50vw, 373px',
};

// Generate 1x / 1.5x / 2x widths, never upscaling past the source.
const SPAN_BASE: Record<number, number> = { 12: 1200, 7: 680, 6: 580, 5: 480, 4: 373 };
function widthsFor(span: number, intrinsic: number): number[] {
  const base = SPAN_BASE[span] ?? 600;
  const set = new Set<number>();
  for (const w of [base, base * 1.5, base * 2]) {
    set.add(Math.min(Math.round(w), intrinsic));
  }
  return [...set].sort((a, b) => a - b);
}

async function metaFor(file: string): Promise<ImageMetadata> {
  const loader = imageModules[`/src/assets/gallery_bw/${file}`];
  if (!loader) throw new Error(`Gallery image not found: src/assets/gallery_bw/${file}`);
  return (await loader()).default;
}

// Pre-resolve metadata + a high-res variant (for the fullscreen detail view).
const cells = await Promise.all(
  rows.map((row, ri) =>
    Promise.all(
      row.map(async (cell) => {
        const meta = await metaFor(cell.img.file);
        const full = await getImage({
          src: meta,
          width: Math.min(1600, meta.width),
          format: 'avif',
        });
        return {
          ...cell,
          meta,
          fullSrc: full.src,
          widths: widthsFor(cell.span, meta.width),
          sizes: SPAN_SIZES[cell.span] ?? '100vw',
          isEarly: ri < 3,
        };
      }),
    ),
  ),
);
---

<main class="gallery-wall">
  {cells.map((row) =>
    row.map((cell) => (
      <div
        class={`gallery-item gi-span-${cell.span}`}
        data-aspect={cell.img.aspect}
        data-bg={cell.img.edgeColor}
        data-full={cell.fullSrc}
        style={`background-color:${cell.img.edgeColor}`}
        role="button"
        tabindex="0"
      >
        <Image
          src={cell.meta}
          alt={cell.img.title}
          widths={cell.widths}
          sizes={cell.sizes}
          format="avif"
          loading={cell.isEarly ? 'eager' : 'lazy'}
          decoding={cell.isEarly ? 'sync' : 'async'}
          fetchpriority={cell.isEarly ? 'high' : undefined}
        />
      </div>
    )),
  )}
</main>

<dialog class="detail-overlay" aria-label="Image view">
  <button class="detail-close" id="detail-close" aria-label="Close" type="button">&times;</button>
  <div class="detail-image-wrap">
    <button class="detail-nav-prev" id="detail-prev" aria-label="Previous image" type="button"></button>
    <img id="detail-img-a" class="detail-img is-active" src="" alt="" />
    <img id="detail-img-b" class="detail-img" src="" alt="" />
    <button class="detail-nav-next" id="detail-next" aria-label="Next image" type="button"></button>
  </div>
</dialog>

<script>
  let controller: AbortController;

  document.addEventListener('astro:page-load', () => {
    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;

    const wall = document.querySelector<HTMLElement>('.gallery-wall');
    const overlay = document.querySelector<HTMLDialogElement>('.detail-overlay');
    if (!wall || !overlay) return;

    const imgA = document.getElementById('detail-img-a') as HTMLImageElement;
    const imgB = document.getElementById('detail-img-b') as HTMLImageElement;
    let activeImg = imgA;
    let nextImg = imgB;

    const galleryItems = wall.querySelectorAll<HTMLElement>('.gallery-item');
    const itemIndex = new Map<Element, number>();
    const navList: { bg: string; src: string; alt: string }[] = [];

    for (const [i, el] of galleryItems.entries()) {
      itemIndex.set(el, i);
      navList.push({
        bg: el.dataset.bg!,
        src: el.dataset.full!,
        alt: el.querySelector('img')!.alt,
      });
    }

    let currentNav = 0;

    function preloadAdjacent() {
      const prev = (currentNav - 1 + navList.length) % navList.length;
      const next = (currentNav + 1) % navList.length;
      new Image().src = navList[prev].src;
      new Image().src = navList[next].src;
    }

    function showImage(data: (typeof navList)[number], isFirst = false) {
      overlay!.style.backgroundColor = data.bg;

      if (isFirst) {
        // First image: simple load into active
        activeImg.src = data.src;
        activeImg.alt = data.alt;
        activeImg.classList.remove('is-loaded');
        activeImg.classList.add('is-active');
        nextImg.classList.remove('is-active', 'is-loaded');
        activeImg.addEventListener('load', () => {
          activeImg.classList.add('is-loaded');
          preloadAdjacent();
        }, { once: true });
        if (activeImg.complete) {
          activeImg.classList.add('is-loaded');
          preloadAdjacent();
        }
        return;
      }

      // Crossfade: load into the hidden image, then swap
      nextImg.classList.remove('is-loaded', 'is-active');
      nextImg.src = data.src;
      nextImg.alt = data.alt;

      const onLoad = () => {
        // Fade in the new image on top
        nextImg.classList.add('is-active', 'is-loaded');
        // Fade out the old image behind
        activeImg.classList.remove('is-active');

        // Swap references
        const tmp = activeImg;
        activeImg = nextImg;
        nextImg = tmp;

        preloadAdjacent();
      };

      nextImg.addEventListener('load', onLoad, { once: true });
      if (nextImg.complete) onLoad();
    }

    function navigate(dir: number) {
      currentNav = (currentNav + dir + navList.length) % navList.length;
      showImage(navList[currentNav]);
    }

    function openDetail(idx: number) {
      currentNav = idx;
      showImage(navList[currentNav], true);
      overlay!.showModal();
    }

    wall.addEventListener('click', (e) => {
      const item = (e.target as HTMLElement).closest('.gallery-item');
      if (!item) return;
      const idx = itemIndex.get(item);
      if (idx !== undefined) openDetail(idx);
    }, { signal });

    wall.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter' && e.key !== ' ') return;
      const item = (e.target as HTMLElement).closest('.gallery-item');
      if (!item) return;
      const idx = itemIndex.get(item);
      if (idx !== undefined) {
        e.preventDefault();
        openDetail(idx);
      }
    }, { signal });

    document.getElementById('detail-close')!.addEventListener('click', () => {
      overlay.close();
    }, { signal });

    document.getElementById('detail-prev')!.addEventListener('click', (e) => {
      e.stopPropagation();
      navigate(-1);
    }, { signal });

    document.getElementById('detail-next')!.addEventListener('click', (e) => {
      e.stopPropagation();
      navigate(1);
    }, { signal });

    overlay.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target === overlay || target.classList.contains('detail-image-wrap')) {
        overlay.close();
      }
    }, { signal });

    document.addEventListener('keydown', (e) => {
      if (!overlay.open) return;
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') navigate(1);
      if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') navigate(-1);
    }, { signal });

    let startX = 0;
    let startY = 0;

    overlay.addEventListener('pointerdown', (e) => {
      startX = e.clientX;
      startY = e.clientY;
    }, { passive: true, signal });

    overlay.addEventListener('pointerup', (e) => {
      const dx = e.clientX - startX;
      const dy = e.clientY - startY;
      if (Math.abs(dx) > Math.abs(dy) && Math.abs(dx) > 50) {
        navigate(dx < 0 ? 1 : -1);
      } else if (Math.abs(dy) > 80) {
        overlay.close();
      }
    }, { passive: true, signal });
  });
</script>
