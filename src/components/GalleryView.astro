---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { composeRows, type GalleryImage, type Item } from '../utils/composeRows';

interface Props {
  images: GalleryImage[];
}

const { images } = Astro.props;

// Optimized binaries, resolved by filename from the gallery asset folder.
const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/gallery_bw/*.{jpg,jpeg}',
);

async function metaFor(file: string): Promise<ImageMetadata> {
  const loader = imageModules[`/src/assets/gallery_bw/${file}`];
  if (!loader) throw new Error(`Gallery image not found: src/assets/gallery_bw/${file}`);
  return (await loader()).default;
}

// Resolve real dimensions FIRST: the justified layout sizes every row from true
// aspect ratios so each row fills the full width at a common height — see
// composeRows.
const metas = await Promise.all(images.map((img) => metaFor(img.file)));
const items: Item[] = images.map((img, k) => ({
  img,
  ar: metas[k].width / metas[k].height,
  isHero: false,
}));
const rows = composeRows(items);

// Mirror composeRows' constants only to estimate the px width each image
// renders at, so `sizes`/`widths` request a right-sized resolution.
const CONTENT_W = 1120;
const GAP = 40;
const metaByFile = new Map(images.map((img, k) => [img.file, metas[k]] as const));

function renderedWidth(row: (typeof rows)[number], ar: number): number {
  if (row.mode === 'hero') return CONTENT_W;
  const sum = row.cells.reduce((s, c) => s + c.ar, 0);
  const rowW = row.mode === 'center' ? (row.maxWidthPx ?? CONTENT_W) : CONTENT_W;
  const avail = rowW - (row.cells.length - 1) * GAP;
  return Math.max(1, Math.round((ar / sum) * avail));
}

// 1x / 1.5x / 2x widths, never upscaling past the source.
function widthsFor(px: number, intrinsic: number): number[] {
  const set = new Set<number>();
  for (const w of [px, px * 1.5, px * 2]) set.add(Math.min(Math.round(w), intrinsic));
  return [...set].sort((a, b) => a - b);
}

// Pre-resolve a high-res variant (for the fullscreen detail view) + responsive
// data per cell.
const renderRows = await Promise.all(
  rows.map(async (row, ri) => {
    const cells = await Promise.all(
      row.cells.map(async (cell) => {
        const meta = metaByFile.get(cell.img.file)!;
        const full = await getImage({
          src: meta,
          width: Math.min(1600, meta.width),
          format: 'avif',
        });
        const px = renderedWidth(row, cell.ar);
        return {
          img: cell.img,
          meta,
          grow: cell.grow,
          fullSrc: full.src,
          widths: widthsFor(px, meta.width),
          sizes:
            row.mode === 'hero'
              ? '(max-width: 768px) 100vw, 1120px'
              : `(max-width: 768px) 100vw, ${px}px`,
          isEarly: ri < 3,
        };
      }),
    );
    // Reserve each row's REAL rendered height for off-screen items (they are
    // content-visibility:auto). A flat estimate makes the scroll position jump
    // as rows render in — matching the true height keeps CLS ~0 (Web Vitals).
    const sumAr = row.cells.reduce((s, c) => s + c.ar, 0);
    const rowW = row.mode === 'center' ? (row.maxWidthPx ?? CONTENT_W) : CONTENT_W;
    const intrinsicH = Math.round((rowW - (row.cells.length - 1) * GAP) / sumAr);
    return { mode: row.mode, maxWidthPx: row.maxWidthPx, intrinsicH, cells };
  }),
);
---

<main class="gallery-wall">
  {renderRows.map((row) => (
    <div
      class:list={[
        'gallery-row',
        row.mode === 'center' && 'gallery-row--center',
        row.mode === 'hero' && 'gallery-row--hero',
      ]}
      style={row.mode === 'center' && row.maxWidthPx ? `max-width:${row.maxWidthPx}px` : undefined}
    >
      {row.cells.map((cell) => (
        <div
          class:list={['gallery-item', cell.isEarly && 'is-early']}
          data-aspect={cell.img.aspect}
          data-bg={cell.img.edgeColor}
          data-full={cell.fullSrc}
          style={`flex-grow:${cell.grow.toFixed(4)};background-color:${cell.img.edgeColor};contain-intrinsic-size:auto ${row.intrinsicH}px`}
          role="button"
          tabindex="0"
        >
          <Image
            src={cell.meta}
            alt={cell.img.title}
            widths={cell.widths}
            sizes={cell.sizes}
            format="avif"
            loading={cell.isEarly ? 'eager' : 'lazy'}
            decoding={cell.isEarly ? 'sync' : 'async'}
            fetchpriority={cell.isEarly ? 'high' : undefined}
          />
        </div>
      ))}
    </div>
  ))}
</main>

<dialog class="detail-overlay" aria-label="Image view">
  <button class="detail-close" id="detail-close" aria-label="Close" type="button">&times;</button>
  <div class="detail-image-wrap">
    <button class="detail-nav-prev" id="detail-prev" aria-label="Previous image" type="button"></button>
    <img id="detail-img-a" class="detail-img is-active" src="" alt="" />
    <img id="detail-img-b" class="detail-img" src="" alt="" />
    <button class="detail-nav-next" id="detail-next" aria-label="Next image" type="button"></button>
  </div>
</dialog>

<script>
  let controller: AbortController;

  // Fullscreen backdrop: derive a neutral ground from the print's edge tone, but
  // shift it clear of that tone (lighter for a dark print, darker for a light one)
  // so the image never sinks into a same-tone background. Deterministic per image.
  function detailBackdrop(hex: string): string {
    const n = parseInt(hex.replace('#', ''), 16);
    const lum = Math.round(
      0.2126 * ((n >> 16) & 255) + 0.7152 * ((n >> 8) & 255) + 0.0722 * (n & 255),
    );
    const GAP = 42;
    const shifted = lum < 128 ? lum + GAP : lum - GAP;
    const b = Math.max(18, Math.min(232, shifted));
    const h = b.toString(16).padStart(2, '0');
    return `#${h}${h}${h}`;
  }

  document.addEventListener('astro:page-load', () => {
    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;

    const wall = document.querySelector<HTMLElement>('.gallery-wall');
    const overlay = document.querySelector<HTMLDialogElement>('.detail-overlay');
    if (!wall || !overlay) return;

    const imgA = document.getElementById('detail-img-a') as HTMLImageElement;
    const imgB = document.getElementById('detail-img-b') as HTMLImageElement;
    let activeImg = imgA;
    let nextImg = imgB;

    const galleryItems = wall.querySelectorAll<HTMLElement>('.gallery-item');
    const itemIndex = new Map<Element, number>();
    const navList: { bg: string; src: string; alt: string }[] = [];

    for (const [i, el] of galleryItems.entries()) {
      itemIndex.set(el, i);
      navList.push({
        bg: detailBackdrop(el.dataset.bg!),
        src: el.dataset.full!,
        alt: el.querySelector('img')!.alt,
      });
    }

    let currentNav = 0;

    function preloadAdjacent() {
      const prev = (currentNav - 1 + navList.length) % navList.length;
      const next = (currentNav + 1) % navList.length;
      new Image().src = navList[prev].src;
      new Image().src = navList[next].src;
    }

    function showImage(data: (typeof navList)[number], isFirst = false) {
      overlay!.style.backgroundColor = data.bg;

      if (isFirst) {
        // First image: simple load into active
        activeImg.src = data.src;
        activeImg.alt = data.alt;
        activeImg.classList.remove('is-loaded');
        activeImg.classList.add('is-active');
        nextImg.classList.remove('is-active', 'is-loaded');
        activeImg.addEventListener('load', () => {
          activeImg.classList.add('is-loaded');
          preloadAdjacent();
        }, { once: true });
        if (activeImg.complete) {
          activeImg.classList.add('is-loaded');
          preloadAdjacent();
        }
        return;
      }

      // Crossfade: load into the hidden image, then swap
      nextImg.classList.remove('is-loaded', 'is-active');
      nextImg.src = data.src;
      nextImg.alt = data.alt;

      const onLoad = () => {
        // Fade in the new image on top
        nextImg.classList.add('is-active', 'is-loaded');
        // Fade out the old image behind
        activeImg.classList.remove('is-active');

        // Swap references
        const tmp = activeImg;
        activeImg = nextImg;
        nextImg = tmp;

        preloadAdjacent();
      };

      nextImg.addEventListener('load', onLoad, { once: true });
      if (nextImg.complete) onLoad();
    }

    function navigate(dir: number) {
      currentNav = (currentNav + dir + navList.length) % navList.length;
      showImage(navList[currentNav]);
    }

    function openDetail(idx: number) {
      currentNav = idx;
      showImage(navList[currentNav], true);
      overlay!.showModal();
    }

    wall.addEventListener('click', (e) => {
      const item = (e.target as HTMLElement).closest('.gallery-item');
      if (!item) return;
      const idx = itemIndex.get(item);
      if (idx !== undefined) openDetail(idx);
    }, { signal });

    wall.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter' && e.key !== ' ') return;
      const item = (e.target as HTMLElement).closest('.gallery-item');
      if (!item) return;
      const idx = itemIndex.get(item);
      if (idx !== undefined) {
        e.preventDefault();
        openDetail(idx);
      }
    }, { signal });

    document.getElementById('detail-close')!.addEventListener('click', () => {
      overlay.close();
    }, { signal });

    document.getElementById('detail-prev')!.addEventListener('click', (e) => {
      e.stopPropagation();
      navigate(-1);
    }, { signal });

    document.getElementById('detail-next')!.addEventListener('click', (e) => {
      e.stopPropagation();
      navigate(1);
    }, { signal });

    overlay.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target === overlay || target.classList.contains('detail-image-wrap')) {
        overlay.close();
      }
    }, { signal });

    document.addEventListener('keydown', (e) => {
      if (!overlay.open) return;
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') navigate(1);
      if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') navigate(-1);
    }, { signal });

    let startX = 0;
    let startY = 0;

    overlay.addEventListener('pointerdown', (e) => {
      startX = e.clientX;
      startY = e.clientY;
    }, { passive: true, signal });

    overlay.addEventListener('pointerup', (e) => {
      const dx = e.clientX - startX;
      const dy = e.clientY - startY;
      if (Math.abs(dx) > Math.abs(dy) && Math.abs(dx) > 50) {
        navigate(dx < 0 ? 1 : -1);
      } else if (Math.abs(dy) > 80) {
        overlay.close();
      }
    }, { passive: true, signal });
  });
</script>
