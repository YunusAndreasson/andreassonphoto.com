---
import { Image } from 'astro:assets';
import { PERSON_NAME, WALL_TITLE } from '../utils/site';
import { AVIF_QUALITY, printPlace, printSlug } from '../utils/gallery';
import { composeRows, rowHeight, type GalleryImage } from '../utils/composeRows';
import { WIDEST_SCALE, wallSizes } from '../utils/layout';

interface Props {
  images: GalleryImage[];
  // On a print's own page (/whooper-swan/), the print the wall opens onto.
  open?: string;
}

const { images, open } = Astro.props;

// `img.file` is already ImageMetadata (the collection's image() schema), so the
// real dimensions are known up front: the justified layout sizes every row from
// true aspect ratios so each row fills the full width at a common height — see
// composeRows.
const rows = composeRows(images.map((img) => ({ img, ar: img.file.width / img.file.height })));

// Every width a print can be asked for: its place on the wall at 1x, 1.5x and
// 2x, the same at 2x on the widest wall, and a whole column on a 2x or 3x phone,
// where even a print hanging narrow on the wall fills the screen. Never past
// the source. Neighbours within 15% merge upward: the browser takes the next
// size up, so one encode serves both and the build stays small.
function widthsFor(px: number, intrinsic: number): number[] {
  const wanted = [px, px * 1.5, px * 2, px * 2 * WIDEST_SCALE, 780, 1170]
    .map((w) => Math.min(Math.round(w), intrinsic))
    .sort((a, b) => b - a);
  const kept: number[] = [];
  for (const w of wanted) if (!kept.length || w < kept.at(-1)! * 0.85) kept.push(w);
  return kept.reverse();
}

// Each print renders at the row's common height, so its width is that height
// times its aspect ratio; `sizes`/`widths` request a right-sized resolution from
// it. (No global image `layout` in astro.config: these explicit widths/sizes
// keep the gallery CSS in full control of image sizing.)
const renderRows = rows.map((row, ri) => {
  const sumAr = row.cells.reduce((s, c) => s + c.ar, 0);
  const rowH = rowHeight(sumAr, row.cells.length);
  const cells = row.cells.map((cell) => {
    const meta = cell.img.file;
    const px = Math.max(1, Math.round(cell.ar * rowH));
    // The first row holds the page's largest paint; the second shows at the
    // fold; the rest wait until the visitor walks to them.
    const isLazy = ri > 1;
    return {
      img: cell.img,
      meta,
      ar: cell.ar,
      // The print's address: /the-lone-boat/ is the wall opened on it.
      slug: printSlug(cell.img.id),
      // The label's second line, for the viewer: "Halland, 2021".
      place: printPlace(cell.img) || undefined,
      grow: cell.grow,
      widths: widthsFor(px, meta.width),
      // Lazy prints let the browser use their real laid-out width
      // (`sizes="auto"`); the estimate after it is the fallback for browsers
      // without it. Eager ones are fetched before layout, so they keep the
      // estimate alone.
      sizes: `${isLazy ? 'auto, ' : ''}${wallSizes(px)}`,
      isFirstRow: ri === 0,
      isLazy,
    };
  });
  // A print hanging alone at full width is a pause in the rhythm of pairs.
  const isHero = row.cells.length === 1;
  return { cells, isHero };
});
---

<main id="main-content" class="gallery-wall" tabindex="-1" data-open={open} data-wall-title={WALL_TITLE}>
  <h1 class="sr-only">{PERSON_NAME} — black-and-white photography</h1>
  <slot />
  {renderRows.map((row) => (
    <div class:list={['gallery-row', row.isHero && 'is-hero']}>
      {row.cells.map((cell) => (
        <div class="gallery-cell" style={`flex-grow:${cell.grow.toFixed(4)};--ar:${cell.ar.toFixed(4)}`}>
          <button
            id={cell.slug}
            type="button"
            disabled
            class:list={['gallery-item', !cell.isLazy && 'is-early']}
            commandfor="detail-view"
            command="show-modal"
            aria-haspopup="dialog"
            data-place={cell.place}
            style={`background-color:${cell.img.edgeColor}`}
          >
            <Image
              src={cell.meta}
              alt={cell.img.title}
              widths={cell.widths}
              sizes={cell.sizes}
              format="avif"
              quality={AVIF_QUALITY}
              priority={cell.isFirstRow}
              loading={cell.isFirstRow ? undefined : cell.isLazy ? 'lazy' : 'eager'}
            />
          </button>
          {/* The wall label: the title, as you lean in. The button already says it. */}
          <span class="gallery-label" aria-hidden="true">{cell.img.title}</span>
        </div>
      ))}
    </div>
  ))}
</main>

{/* Every control here is declarative: invoker commands (command/commandfor)
    arrive as `command` events on the dialog, including the two custom ones
    (--prev/--next), and the script carries them out. `autofocus` focuses the
    dialog itself on open, so no button wears a focus ring before anyone has
    pressed a key; arrows and Escape work from there. The icons are drawn, not
    typed, so they sit centred in their circles in every browser and font. */}
<dialog id="detail-view" class="detail-overlay" aria-label="Image view" aria-describedby="detail-help" tabindex="-1" autofocus>
  <p id="detail-help" class="sr-only">Use the arrow keys or swipe to browse photographs. Press Escape to close.</p>
  <button class="detail-close" type="button" commandfor="detail-view" command="close" aria-label="Close"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
  <div class="detail-image-wrap">
    <button class="detail-nav-prev" type="button" commandfor="detail-view" command="--prev" aria-label="Previous image"><span><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.5 5.5 8 12l6.5 6.5"/></svg></span></button>
    <img class="detail-img" alt="" draggable="false" aria-hidden="true" />
    <img class="detail-img" alt="" draggable="false" aria-hidden="true" />
    <button class="detail-nav-next" type="button" commandfor="detail-view" command="--next" aria-label="Next image"><span><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.5 5.5 16 12l-6.5 6.5"/></svg></span></button>
  </div>
  {/* A museum label for sighted visitors; the status line says the same to
      screen readers, including "loading" and errors. */}
  <p class="detail-caption" aria-hidden="true"><span class="detail-label"><span class="detail-title"></span><span class="detail-place"></span></span><span class="detail-count"></span></p>
  <p class="detail-status sr-only" role="status" aria-atomic="true"></p>
</dialog>

<script>
  import { pageTitle } from '../utils/site';

  interface Print {
    item: HTMLButtonElement;
    thumb: HTMLImageElement;
    alt: string;
    place: string;
    slug: string;
    srcset: string;
    sizes: string;
    full: string;
    fullWidth: number;
    ar: number;
  }

  let controller: AbortController;

  // Firefox (and Zen) sometimes reject decode() with "Invalid image request"
  // for an image that loads fine, so on a rejection trust the load itself.
  async function ready(img: HTMLImageElement) {
    try {
      await img.decode();
    } catch {
      if (!img.complete) {
        await new Promise((resolve, reject) => {
          img.addEventListener('load', resolve, { once: true });
          img.addEventListener('error', reject, { once: true });
        });
      }
      if (!img.naturalWidth) throw new Error('image failed to load');
    }
  }

  // The width a print takes in the viewer, for choosing its source: the same
  // sum as .detail-img in the stylesheet, with its margins and breakpoints.
  function viewerSizes(ar: number, width: number) {
    const fit = (x: string, y: string) => `min(100vw - ${x}, (100vh - ${y}) * ${+ar.toFixed(3)}, ${width}px)`;
    return `(height <= 500px) ${fit('0px', '6rem')}, (width <= 768px) ${fit('0px', '20vh')}, ${fit('8rem', '8rem')}`;
  }

  // The print's proportions and full size go to CSS, which sizes the frame from
  // them: the frame is right before any pixels arrive, whichever copy they are.
  function hang(img: HTMLImageElement, print: Print) {
    img.style.setProperty('--ar', String(print.ar));
    img.style.setProperty('--print-width', `${print.fullWidth}px`);
    img.alt = print.alt;
  }

  // Fetch and decode off-screen, so stepping to it later is instant.
  function preload({ sizes, srcset, full }: Print) {
    const img = new Image();
    img.sizes = sizes;
    img.srcset = srcset;
    img.src = full;
    img.decode().catch(() => {});
  }

  document.addEventListener('astro:page-load', () => {
    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;

    const overlay = document.querySelector<HTMLDialogElement>('#detail-view');
    if (!overlay) return;
    const main = document.querySelector<HTMLElement>('.gallery-wall')!;
    const status = overlay.querySelector<HTMLElement>('.detail-status')!;
    const title = overlay.querySelector<HTMLElement>('.detail-title')!;
    const place = overlay.querySelector<HTMLElement>('.detail-place')!;
    const count = overlay.querySelector<HTMLElement>('.detail-count')!;

    const galleryItems = [...document.querySelectorAll<HTMLButtonElement>('.gallery-item')];

    // Prints fade in as they scroll into view (CSS keeps them visible with
    // scripting off or motion reduced). A fade in time, once, not one tied to
    // the scroll: a scroll-driven fade would leave a print half there for as
    // long as someone scrolls slowly past it.
    const reveal = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        entry.target.classList.add('is-visible');
        reveal.unobserve(entry.target);
      }
    }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
    for (const el of galleryItems) reveal.observe(el);
    signal.addEventListener('abort', () => reveal.disconnect());

    // Two stacked <img>s: the next print decodes in the hidden one, then the
    // two crossfade.
    let [activeImg, nextImg] = overlay.querySelectorAll<HTMLImageElement>('.detail-img');

    // Everything the viewer needs is already on the wall's own <img>: its
    // `src` is the print at full size, its `width` and `height` the source's.
    const prints: Print[] = galleryItems.map((item) => {
      const thumb = item.querySelector('img')!;
      const full = thumb.getAttribute('src')!;
      const fullWidth = Number(thumb.getAttribute('width'));
      const ar = fullWidth / Number(thumb.getAttribute('height'));
      return {
        item,
        thumb,
        alt: thumb.alt,
        place: item.dataset.place ?? '',
        slug: item.id,
        full,
        fullWidth,
        ar,
        srcset: `${thumb.srcset}, ${full} ${fullWidth}w`,
        sizes: viewerSizes(ar, fullWidth),
      };
    });

    // A print develops over its tone once its pixels are here (see the CSS).
    for (const { thumb } of prints) {
      const developed = () => thumb.classList.add('is-loaded');
      if (thumb.complete) developed();
      else {
        thumb.addEventListener('load', developed, { once: true, signal });
        thumb.addEventListener('error', developed, { once: true, signal });
      }
    }

    let currentNav = 0;
    let opener: HTMLButtonElement | undefined;

    // Bumped whenever the print changes, so a decode that finishes after the
    // user has moved on can't swap a stale image in.
    let loadToken = 0;

    // Load the print's right-sized source into a hidden <img>.
    function load(img: HTMLImageElement, print: Print) {
      img.classList.remove('is-active', 'is-under');
      img.setAttribute('aria-hidden', 'true');
      hang(img, print);
      img.sizes = print.sizes;
      img.srcset = print.srcset;
      img.src = print.full;
    }

    function preloadNeighbours() {
      preload(prints[(currentNav + 1) % prints.length]);
      preload(prints[(currentNav - 1 + prints.length) % prints.length]);
    }

    // Sets the label and the address (the page's own history state is kept).
    function announce() {
      const { alt, place: where, slug } = prints[currentNav];
      status.textContent = `${currentNav + 1} of ${prints.length} · ${[alt, where].filter(Boolean).join(', ')}`;
      title.textContent = alt;
      place.textContent = where;
      count.textContent = `${currentNav + 1} / ${prints.length}`;
      history.replaceState(history.state, '', `/${slug}/`);
      document.title = pageTitle(alt);
    }

    // The print fades up over what is there, then the two change places. The
    // old one holds full strength underneath when the new one is only a
    // sharper copy of it (`keep`), so the swap shows no dip in the light.
    function swapIn(img: HTMLImageElement, keep = false) {
      const old = activeImg;
      img.classList.add('is-active');
      img.removeAttribute('aria-hidden');
      old.classList.remove('is-active');
      old.setAttribute('aria-hidden', 'true');
      if (keep) {
        old.classList.add('is-under');
        setTimeout(() => old.classList.remove('is-under'), 500);
      }
      [activeImg, nextImg] = [img, old];
    }

    async function navigate(dir: number) {
      currentNav = (currentNav + dir + prints.length) % prints.length;
      const print = prints[currentNav];
      const token = ++loadToken;
      status.textContent = `Loading photograph ${currentNav + 1} of ${prints.length}…`;
      const img = nextImg;
      load(img, print);
      try {
        await ready(img); // pixels ready to paint, so the fade never stutters
      } catch {
        if (token === loadToken) status.textContent = 'This photograph could not load. Try the next or previous image.';
        return;
      }
      if (token !== loadToken) return;
      swapIn(img);
      announce();
      preloadNeighbours();
    }

    // The print moving between the wall and the viewer is one view transition:
    // the frame carries the name in whichever state holds it. Older browsers
    // and reduced motion get the dialog's plain fade instead.
    const canMorph = () =>
      'startViewTransition' in document &&
      CSS.supports('selector(:active-view-transition-type(print))') &&
      !matchMedia('(prefers-reduced-motion: reduce)').matches;

    async function openViewer(index: number, fromWall = true) {
      if (overlay!.open) return;
      currentNav = index;
      const print = prints[index];
      const token = ++loadToken;
      opener = print.item;
      activeImg.classList.remove('is-active', 'is-under');
      nextImg.classList.remove('is-active', 'is-under');
      title.textContent = place.textContent = count.textContent = '';

      // The copy on the wall is already decoded, so the print is there at once;
      // the sharper source fades in over it when it arrives.
      const hasCopy = fromWall && print.thumb.complete && print.thumb.naturalWidth > 0;
      if (hasCopy) {
        hang(activeImg, print);
        activeImg.removeAttribute('srcset');
        activeImg.removeAttribute('sizes');
        activeImg.src = print.thumb.currentSrc;
        await ready(activeImg).catch(() => {});
        if (token !== loadToken || overlay!.open) return;
      }

      const show = () => {
        overlay!.showModal();
        // Not every engine honours `autofocus` on the dialog yet: hold focus on
        // the dialog rather than its first button.
        if (document.activeElement !== overlay) overlay!.focus();
        if (hasCopy) {
          activeImg.classList.add('is-active');
          activeImg.removeAttribute('aria-hidden');
          announce();
        }
      };

      let settled: Promise<unknown> = Promise.resolve();
      if (hasCopy && canMorph()) {
        print.item.style.viewTransitionName = 'print';
        const transition = document.startViewTransition({
          update() {
            print.item.style.viewTransitionName = '';
            activeImg.style.viewTransitionName = 'print';
            show();
          },
          types: ['print'],
        });
        settled = transition.finished.catch(() => {}).then(() => {
          activeImg.style.viewTransitionName = '';
        });
      } else {
        show();
      }

      wake();

      const target = nextImg;
      if (!hasCopy) status.textContent = `Loading photograph ${index + 1} of ${prints.length}…`;
      load(target, print);
      try {
        await ready(target);
      } catch {
        if (token === loadToken && !hasCopy) status.textContent = 'This photograph could not load. Try the next or previous image.';
        return;
      }
      await settled;
      if (token !== loadToken || !overlay!.open) return;
      swapIn(target, hasCopy);
      if (!hasCopy) announce();
      preloadNeighbours();
    }

    // Back on the wall, you stand in front of the print you were last looking
    // at: scrolled to it if you walked away from where you opened, and with the
    // keyboard's focus on it, whichever way you got there.
    function returnToWall() {
      const { item } = prints[currentNav];
      item.classList.add('is-visible');
      const { top, bottom } = item.getBoundingClientRect();
      if (item !== opener && (top < 0 || bottom > innerHeight)) {
        item.scrollIntoView({ block: 'center', behavior: 'instant' });
      }
      if (document.activeElement !== item) item.focus({ preventScroll: true });
    }

    function closeViewer() {
      if (!overlay!.open) return;
      const { item, thumb } = prints[currentNav];
      if (!canMorph() || !activeImg.classList.contains('is-active')) {
        overlay!.close();
        return;
      }
      activeImg.style.viewTransitionName = 'print';
      const transition = document.startViewTransition({
        async update() {
          activeImg.style.viewTransitionName = '';
          overlay!.close();
          returnToWall();
          item.style.viewTransitionName = 'print';
          // A print you reached in the viewer may never have loaded on the
          // wall: give it a moment, so the frame doesn't land on an empty mat.
          thumb.loading = 'eager';
          await Promise.race([thumb.decode().catch(() => {}), new Promise((resolve) => setTimeout(resolve, 250))]);
          if (thumb.complete) thumb.classList.add('is-loaded');
        },
        types: ['print'],
      });
      transition.finished.catch(() => {}).then(() => {
        item.style.viewTransitionName = '';
      });
    }

    function handleCommand(command: string, source: Element | null) {
      const index = galleryItems.indexOf(source as HTMLButtonElement);
      if (command === 'show-modal' && index >= 0) openViewer(index);
      else if (command === 'close') closeViewer();
      else if (command === '--next') navigate(1);
      else if (command === '--prev') navigate(-1);
    }

    // The buttons name the commands and the handler carries them out, so the
    // print can travel as the dialog opens and closes.
    overlay.addEventListener('command', (e) => {
      e.preventDefault();
      const { command, source } = e as CommandEvent;
      handleCommand(command, source);
    }, { signal });

    // Keep the native commands above; older browsers get the same controls.
    if (!('commandForElement' in HTMLButtonElement.prototype)) {
      document.addEventListener('click', (e) => {
        const button = (e.target as Element).closest<HTMLButtonElement>('[commandfor="detail-view"]');
        if (!button || e.defaultPrevented) return;
        handleCommand(button.getAttribute('command')!, button);
      }, { signal });
    }

    // Escape, or the back gesture on Android. The browser allows holding the
    // close back once per user action; if it won't, it closes as a plain fade.
    overlay.addEventListener('cancel', (e) => {
      if (!e.cancelable || !canMorph()) return;
      e.preventDefault();
      closeViewer();
    }, { signal });

    overlay.addEventListener('close', () => {
      ++loadToken;
      status.textContent = '';
      clearTimeout(idleTimer);
      overlay.classList.remove('is-idle');
      returnToWall();
      history.replaceState(history.state, '', '/');
      document.title = main.dataset.wallTitle!;
    }, { signal });

    // With a mouse, the controls and label fade away while the pointer rests
    // and come back as soon as it moves, leaving just the print. Touch has no
    // resting pointer, so there they stay. A focused button stays visible
    // (CSS), so keyboard use is never left without its controls.
    let idleTimer = 0;
    function wake() {
      overlay!.classList.remove('is-idle');
      clearTimeout(idleTimer);
      if (!matchMedia('(hover: hover)').matches) return;
      idleTimer = window.setTimeout(() => overlay!.classList.add('is-idle'), 2500);
    }
    overlay.addEventListener('pointermove', wake, { passive: true, signal });
    overlay.addEventListener('pointerdown', wake, { passive: true, signal });
    signal.addEventListener('abort', () => clearTimeout(idleTimer));

    // Clicking the print or the ground around it steps back, as you came in.
    overlay.addEventListener('click', (e) => {
      const { classList } = e.target as Element;
      if (e.target === overlay || classList.contains('detail-image-wrap') || classList.contains('detail-img')) {
        closeViewer();
      }
    }, { signal });

    // Focus is always inside the modal dialog, so it hears every key.
    overlay.addEventListener('keydown', (e) => {
      if (['ArrowRight', 'ArrowDown', 'ArrowLeft', 'ArrowUp'].includes(e.key)) {
        e.preventDefault();
        navigate(e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : -1);
      }
    }, { signal });

    let pointerStart: { id: number; x: number; y: number } | null = null;
    let suppressClick = false;

    overlay.addEventListener('pointerdown', (e) => {
      suppressClick = false;
      pointerStart = e.isPrimary && e.button === 0
        ? { id: e.pointerId, x: e.clientX, y: e.clientY }
        : null;
    }, { passive: true, signal });

    overlay.addEventListener('pointerup', (e) => {
      if (!pointerStart || e.pointerId !== pointerStart.id) return;
      const dx = e.clientX - pointerStart.x;
      const dy = e.clientY - pointerStart.y;
      pointerStart = null;
      if (Math.abs(dx) > Math.abs(dy) && Math.abs(dx) > 50) {
        suppressClick = true;
        navigate(dx < 0 ? 1 : -1);
      } else if (Math.abs(dy) > 80) {
        suppressClick = true;
        closeViewer();
      }
    }, { passive: true, signal });

    overlay.addEventListener('pointercancel', () => { pointerStart = null; }, { signal });
    // A completed swipe also produces a click. Consume it before a navigation
    // button's native command or the backdrop close handler can act twice.
    overlay.addEventListener('click', (e) => {
      if (!suppressClick || e.detail === 0) return;
      suppressClick = false;
      e.preventDefault();
      e.stopImmediatePropagation();
    }, { capture: true, signal });

    // Enable only when the viewer is ready. With scripting disabled the wall
    // remains readable without opening an empty native dialog.
    for (const item of galleryItems) item.disabled = false;

    // Each print has its own page (/the-lone-boat/): the wall, opened onto
    // it. The viewer keeps that address while the print is open, so it can be
    // copied and sent, with the print as its preview; closing returns to /.
    // The older form, /#the-lone-boat, still opens it, whether it loads the
    // page or, from the wall itself, only changes the address.
    const openLinked = () => {
      const wanted = location.hash ? location.hash.slice(1) : main.dataset.open;
      delete main.dataset.open; // once: a later change of address mustn't reopen it
      const linked = prints.findIndex(({ slug }) => slug === wanted);
      if (linked >= 0) openViewer(linked, false);
    };
    window.addEventListener('hashchange', openLinked, { signal });
    openLinked();
  });
</script>
