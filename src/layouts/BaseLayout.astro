---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const siteName = 'Andrèasson Photo';
const siteOrigin = Astro.site?.origin ?? 'https://andreassonphoto.com';

const {
  title = siteName,
  description = 'Quiet observations in black and white',
  ogImage = '/og/the-lone-tree.jpg',
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, siteOrigin);
const ogImageUrl = new URL(ogImage, siteOrigin).href;

// Current page, so the nav can show "you are here" (Nielsen #1 / aria-current).
const navPath = Astro.url.pathname.replace(/\/+$/, '') || '/';

// The maker's identity node — canonical across every site Yunus builds; this
// personal site is the hub, so the Person stands alone (no Organization node).
// Same @id everywhere lets crawlers fold the mentions into one entity.
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': 'https://andreassonphoto.com/#person',
  name: 'Yunus Andreasson',
  alternateName: ['Jonas Yūnus Andrèasson'],
  url: 'https://andreassonphoto.com',
  jobTitle: 'Photographer & software developer',
  description:
    'Photographer working quietly in black and white, and an independent software developer building Islamic knowledge and prayer-time apps.',
  knowsAbout: [
    'Photography',
    'Black and white photography',
    'Islamic knowledge apps',
    'Software development',
    'Arabic',
  ],
  sameAs: [
    'https://github.com/YunusAndreasson',
    'https://x.com/YunusAndreasson',
    'https://www.instagram.com/andreasson.photo/',
    'https://www.linkedin.com/in/yunusandreasson/',
  ],
};
---

<!-- Perhaps, if we take the time to look beyond the obvious, we find beauty in what at first glance slipped quietly by. -->
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="author" content="Yunus Andreasson" />
    <meta name="theme-color" content="#73716c" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="800" />
    <meta property="og:locale" content="en_GB" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@YunusAndreasson" />
    <meta name="twitter:creator" content="@YunusAndreasson" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="preload" href="/fonts/cormorant-garamond-light.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/cormorant-garamond-light-italic.woff2" as="font" type="font/woff2" crossorigin />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />
    <slot name="head" />
    <ClientRouter />
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="site-name">{siteName}</a>
      <nav class="site-nav">
        <a href="/" class:list={{ 'is-current': navPath === '/' }} aria-current={navPath === '/' ? 'page' : undefined}>Work</a>
        <a href="/about" class:list={{ 'is-current': navPath === '/about' }} aria-current={navPath === '/about' ? 'page' : undefined}>Words</a>
      </nav>
    </header>

    <slot />

    <footer class="site-footer">
      <a href="/about" class="footer-byline">Yunus Andreasson</a>
      <p class="footer-note">Quiet observations in black and white.</p>
      <nav class="contact-links footer-social" aria-label="Elsewhere">
        <a href="https://github.com/YunusAndreasson" rel="me noopener noreferrer" target="_blank">GitHub</a>
        <a href="https://x.com/YunusAndreasson" rel="me noopener noreferrer" target="_blank">X</a>
        <a href="https://www.instagram.com/andreasson.photo/" rel="me noopener noreferrer" target="_blank">Instagram</a>
        <a href="https://www.linkedin.com/in/yunusandreasson/" rel="me noopener noreferrer" target="_blank">LinkedIn</a>
      </nav>
    </footer>

    <script>
      let lastScrollY = 0;

      document.addEventListener('astro:page-load', () => {
        const header = document.querySelector('.site-header') as HTMLElement;
        if (!header) return;

        lastScrollY = window.scrollY;
        header.classList.remove('is-hidden');

        window.addEventListener('scroll', () => {
          const y = window.scrollY;
          if (y > lastScrollY && y > 80) {
            header.classList.add('is-hidden');
          } else {
            header.classList.remove('is-hidden');
          }
          lastScrollY = y;
        }, { passive: true });
      });
    </script>

    <script>
      let observer: IntersectionObserver;

      document.addEventListener('astro:page-load', () => {
        observer?.disconnect();

        observer = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          }
        }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

        for (const el of document.querySelectorAll('.gallery-item')) {
          observer.observe(el);
        }
      });
    </script>
  </body>
</html>
