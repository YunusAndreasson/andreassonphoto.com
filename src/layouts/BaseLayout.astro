---
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Andreasson Photo',
  description = 'Black & white fine art photography',
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://andreassonphoto.com');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="preload" href="/fonts/cormorant-garamond-light.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/cormorant-garamond-light-italic.woff2" as="font" type="font/woff2" crossorigin />
    <ClientRouter />
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="site-name">Andreasson Photo</a>
      <nav class="site-nav">
        <a href="/">Gallery</a>
        <a href="/about">About</a>
      </nav>
    </header>

    <slot />

    <footer class="site-footer">
      &copy; {new Date().getFullYear()} Andreasson Photo
    </footer>

    <script>
      let controller: AbortController;
      let observer: IntersectionObserver;

      document.addEventListener('astro:page-load', () => {
        controller?.abort();
        observer?.disconnect();

        controller = new AbortController();
        const { signal } = controller;

        const header = document.querySelector('.site-header');
        if (!header) return;

        let lastScroll = 0;

        window.addEventListener('scroll', () => {
          const current = window.scrollY;
          if (current < lastScroll || current < 100) {
            header.classList.remove('is-hidden');
          } else if (current > lastScroll && current > 100) {
            header.classList.add('is-hidden');
          }
          lastScroll = current;
        }, { passive: true, signal });

        observer = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          }
        }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

        for (const el of document.querySelectorAll('.gallery-item')) {
          observer.observe(el);
        }
      });
    </script>
  </body>
</html>
