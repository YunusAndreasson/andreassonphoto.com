---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { NAV, PERSON_FULL_NAME, PERSON_ID, PERSON_NAME, SAME_AS, SITE_NAME, SITE_ORIGIN } from '../utils/site';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  preloadProse?: boolean;
}

const {
  title = SITE_NAME,
  description = `Black-and-white photographs by ${PERSON_NAME}`,
  ogImage = '/og/the-lone-tree.jpg',
  preloadProse = false,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, SITE_ORIGIN);
const ogImageUrl = new URL(ogImage, SITE_ORIGIN).href;

// Current page, so the nav can show "you are here" (Nielsen #1 / aria-current).
const navPath = Astro.url.pathname.replace(/\/+$/, '') || '/';

// The maker's identity node — canonical across every site Yunus builds; this
// personal site is the hub, so the Person stands alone (no Organization node).
// Same @id everywhere lets crawlers fold the mentions into one entity.
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': PERSON_ID,
  name: PERSON_NAME,
  alternateName: [PERSON_FULL_NAME, 'Yunus Andreasson'],
  url: SITE_ORIGIN,
  jobTitle: 'Photographer & software developer',
  description:
    'Photographer working in black and white, who also makes websites for prayer times, Islamic texts and learning Arabic.',
  knowsAbout: [
    'Photography',
    'Black and white photography',
    'Islamic knowledge apps',
    'Software development',
    'Arabic',
  ],
  sameAs: SAME_AS,
};
---

<!-- Perhaps, if we take the time to look beyond the obvious, we find beauty in what at first glance slipped quietly by. -->
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="author" content={PERSON_NAME} />
    <meta name="theme-color" content="#4f4d49" />
    <!-- Paints the first frame dark, before the stylesheet arrives. -->
    <meta name="color-scheme" content="dark" />
    <!-- The manifest (display: standalone) is the standard home-screen opt-in,
         replacing the deprecated apple-mobile-web-app-capable. -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="800" />
    <meta property="og:locale" content="en_GB" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@YunusAndreasson" />
    <meta name="twitter:creator" content="@YunusAndreasson" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    <!-- The shared navigation always needs Medium. Text pages also preload
         their italic lead; other faces stay on demand beside the photographs. -->
    <Font cssVariable="--font-cormorant" preload={[{ weight: 500, style: 'normal' }]} />
    <Font cssVariable="--font-eb-garamond" preload={preloadProse ? [{ weight: 400, style: 'italic' }] : false} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />
    <slot name="head" />
    <!-- Page transitions via startViewTransition (same-document). Kept over
         native cross-document @view-transition, which Firefox/Zen lack. -->
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <a href="/" class="site-name">{SITE_NAME}</a>
      <nav class="site-nav" aria-label="Main">
        {NAV.map(({ href, label }) => (
          <a href={href} aria-current={navPath === href ? 'page' : undefined}>{label}</a>
        ))}
      </nav>
    </header>

    <slot />

    <footer class="site-footer">
      <!-- Decomposed accents use the combining glyphs in our Latin font subset. -->
      <a href="/about" class="footer-byline">{PERSON_NAME.normalize('NFD')}</a>
      <p class="footer-note">Photographs in black and white.</p>
      <nav class="footer-social" aria-label="Contact">
        <a href="mailto:yunus@edenmind.com">Email</a>
      </nav>
    </footer>

    <script>
      let controller: AbortController;

      document.addEventListener('astro:page-load', () => {
        // `window` survives ClientRouter navigations, so drop the previous
        // page's scroll listener before adding one for the new header.
        controller?.abort();
        controller = new AbortController();

        const header = document.querySelector<HTMLElement>('.site-header');
        if (!header) return;

        // Hide while scrolling down past the top; any scroll up brings it back.
        let lastY = window.scrollY;
        header.classList.remove('is-hidden');
        window.addEventListener('scroll', () => {
          const y = window.scrollY;
          header.classList.toggle('is-hidden', y > lastY && y > 80);
          lastY = y;
        }, { passive: true, signal: controller.signal });
      });
    </script>
  </body>
</html>
