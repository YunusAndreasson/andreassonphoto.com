---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { NAV, PERSON_ID, PERSON_NAME, SAME_AS, SITE_NAME, SITE_ORIGIN } from '../utils/site';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  preloadProse?: boolean;
  // A page with no address of its own (the 404, served for any unknown URL):
  // kept out of search, and naming no canonical URL for crawlers to follow.
  noindex?: boolean;
}

const {
  title = SITE_NAME,
  description = `Black-and-white photographs by ${PERSON_NAME}`,
  ogImage = '/og/the-lone-tree.jpg',
  ogImageAlt = `The Lone Tree, a black-and-white photograph by ${PERSON_NAME}`,
  preloadProse = false,
  noindex = false,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, SITE_ORIGIN);
const ogImageUrl = new URL(ogImage, SITE_ORIGIN).href;

// Current page, so the nav can show "you are here" (Nielsen #1 / aria-current):
// `page` on the section itself, `true` on a page inside it (a poem's own page).
// Folder form, as the nav links are, whether or not the request had the slash.
const navPath = Astro.url.pathname.replace(/\/*$/, '/');

// The maker's identity node — canonical across every site Yunus builds; this
// personal site is the hub, so the Person stands alone (no Organization node).
// Same @id everywhere lets crawlers fold the mentions into one entity.
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': PERSON_ID,
  name: PERSON_NAME,
  alternateName: ['Yūnus Andrèasson', 'Jonas Yunus Andreasson', 'Yunus Andreasson'],
  url: SITE_ORIGIN,
  jobTitle: 'Photographer & software developer',
  description:
    'Photographer working in black and white, who also makes websites for prayer times, Islamic texts and learning Arabic.',
  knowsAbout: [
    'Photography',
    'Black and white photography',
    'Islamic knowledge websites',
    'Software development',
    'Arabic',
  ],
  sameAs: SAME_AS,
};
---

<!-- Perhaps, if we take the time to look beyond the obvious, we find beauty in what at first glance slipped quietly by. -->
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="author" content={PERSON_NAME} />
    {/* The top of the wall (--wall-glow), so the browser's bar runs into the
        page without a seam. */}
    <meta name="theme-color" content="#57554f" />
    {/* Paints the first frame dark, before the stylesheet arrives. */}
    <meta name="color-scheme" content="dark" />
    {/* The manifest (display: standalone) is the standard home-screen opt-in,
        replacing the deprecated apple-mobile-web-app-capable. */}
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {!noindex && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="800" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content="en_GB" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@YunusAndreasson" />
    <meta name="twitter:creator" content="@YunusAndreasson" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalUrl} />}
    {/* The shared navigation always needs Medium. Text pages also preload
        their italic lead; other faces stay on demand beside the photographs. */}
    <Font cssVariable="--font-cormorant" preload={[{ weight: 500, style: 'normal' }]} />
    <Font cssVariable="--font-eb-garamond" preload={preloadProse ? [{ weight: 400, style: 'italic' }] : false} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />
    <slot name="head" />
    {/* Page transitions via startViewTransition (same-document). Kept over
        native cross-document @view-transition, which Firefox/Zen lack. */}
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      {/* The four ways around are fetched as soon as the header is on screen,
          not on hover (ClientRouter's default): a touch screen never hovers,
          and each page is ~11 KB. Astro skips this on a data saver. */}
      <a href="/" class="site-name" data-astro-prefetch="viewport" aria-current={navPath === '/' ? 'page' : undefined}>{SITE_NAME}</a>
      <nav class="site-nav" aria-label="Main">
        {NAV.map(({ href, label }) => (
          <a href={href} data-astro-prefetch="viewport" aria-current={navPath === href ? 'page' : navPath.startsWith(href) ? 'true' : undefined}>{label}</a>
        ))}
      </nav>
    </header>

    <slot />

    <footer class="site-footer">
      <a href="/" class="footer-byline">{PERSON_NAME}</a>
      <nav class="footer-social" aria-label="Contact">
        <a href="mailto:yunus@edenmind.com">Email</a>
      </nav>
    </footer>

    <script>
      import '../scripts/poem-travel';

      let controller: AbortController;

      document.addEventListener('astro:page-load', () => {
        // `window` survives ClientRouter navigations, so drop the previous
        // page's scroll listener before adding one for the new header.
        controller?.abort();
        controller = new AbortController();

        const header = document.querySelector<HTMLElement>('.site-header');
        if (!header) return;

        // At the top of a page the header rests on the bare wall; its shade
        // comes in once something is passing beneath it. It hides while
        // scrolling down past the top, and a real scroll up brings it back:
        // the few pixels a trackpad drifts when it settles don't count.
        let lastY = window.scrollY;
        const update = () => {
          const y = window.scrollY;
          header.classList.toggle('is-scrolled', y > 16);
          if (Math.abs(y - lastY) < 6) return;
          header.classList.toggle('is-hidden', y > lastY && y > 80);
          lastY = y;
        };
        header.classList.remove('is-hidden');
        update();
        window.addEventListener('scroll', update, { passive: true, signal: controller.signal });
      });

      // Each page loads only the faces it sets, so the next page could open in
      // the fallback and change its letters a beat later as its own faces
      // arrive. Once this page has loaded and the browser is idle, fetch the
      // rest (four small subsets in all) so the next page opens in its own
      // type. Not on a data saver; after the first page this finds nothing
      // left to load.
      const warmFonts = () => {
        if ((navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData) return;
        const idle = window.requestIdleCallback ?? ((fn: () => void) => setTimeout(fn, 200));
        idle(() => {
          document.fonts.forEach((face) => {
            if (face.status === 'unloaded') face.load().catch(() => {});
          });
        });
      };

      document.addEventListener('astro:page-load', () => {
        if (document.readyState === 'complete') warmFonts();
        else window.addEventListener('load', warmFonts, { once: true });
      });
    </script>
  </body>
</html>
