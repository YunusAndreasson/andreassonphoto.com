---
import BaseLayout from '../layouts/BaseLayout.astro';

// This is the hub page for the maker's identity, so it carries a ProfilePage
// node whose mainEntity points at the canonical Person (defined in BaseLayout).
// dateModified is the static-build timestamp — honest, regenerated each build.
const profilePageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  dateModified: new Date().toISOString(),
  mainEntity: { '@id': 'https://andreassonphoto.com/#person' },
};
---

<BaseLayout title="Andrèasson Photo — Words" description="Finding beauty in what at first glance slipped quietly by">
  <script type="application/ld+json" is:inline set:html={JSON.stringify(profilePageSchema)} slot="head" />
  <div class="page-content">
    <p class="invocation">
      In the name of God,<br>
      the Most Gracious, the Most Merciful.
    </p>
    <div class="verse">
      <p>
        Our gaze is drawn instinctively<br>
        to bright colours, bold contrasts,<br>
        and all that places itself<br>
        at the centre.
      </p>
      <p>
        But is this truly what is beautiful?
      </p>
      <p>
        Perhaps, if we take the time<br>
        to look beyond the obvious,<br>
        we find beauty in what at first glance<br>
        slipped quietly by.
      </p>
      <p>
        And if we can do this,<br>
        we need not climb the hilltop<br>
        nor travel to distant lands<br>
        to find the beautiful.<br>
        We may discover it here,<br>
        close by, right here.
      </p>
    </div>
    <p class="about-signature">
      Jonas Yu&#x0304;nus Andr&egrave;asson
    </p>
    <nav class="contact-links">
      <a href="https://github.com/YunusAndreasson" rel="me noopener noreferrer" target="_blank">GitHub</a>
      <a href="https://x.com/YunusAndreasson" rel="me noopener noreferrer" target="_blank">X</a>
      <a href="https://www.instagram.com/andreasson.photo/" rel="me noopener noreferrer" target="_blank">Instagram</a>
      <a href="https://www.linkedin.com/in/yunusandreasson/" rel="me noopener noreferrer" target="_blank">LinkedIn</a>
    </nav>

    <section class="also-building" aria-labelledby="also-building-heading">
      <h2 id="also-building-heading" class="section-label">Also building</h2>
      <ul class="project-list">
        <li>
          <a href="https://islam.se" rel="noopener noreferrer" target="_blank">islam.se</a>
          <span class="project-desc">Swedish Islamic knowledge &amp; prayer times</span>
        </li>
        <li>
          <a href="https://openarabic.io" rel="noopener noreferrer" target="_blank">open-arabic</a>
          <span class="project-desc">Learn to read Arabic</span>
        </li>
        <li>
          <a href="https://al-ibadah.com" rel="noopener noreferrer" target="_blank">al-ibadah</a>
          <span class="project-desc">Islamic knowledge collection (Swedish)</span>
        </li>
        <li>
          <a href="https://zuhd.news" rel="noopener noreferrer" target="_blank">zuhd.news</a>
          <span class="project-desc">Calm Islamic news</span>
        </li>
        <li>
          <a href="https://qamar360.com" rel="noopener noreferrer" target="_blank">qamar360</a>
          <span class="project-desc">Prayer-habit companion</span>
        </li>
        <li>
          <a href="https://edenmind.com" rel="noopener noreferrer" target="_blank">edenmind</a>
          <span class="project-desc">Voice-first spaced repetition</span>
        </li>
        <li>
          <a href="https://mygjakova.com" rel="noopener noreferrer" target="_blank">mygjakova</a>
          <span class="project-desc">Cultural guide to Gjakova, Kosovo</span>
        </li>
      </ul>
    </section>
  </div>
</BaseLayout>
