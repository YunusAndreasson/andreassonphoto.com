---
import BaseLayout from '../layouts/BaseLayout.astro';

// This is the hub page for the maker's identity, so it carries a ProfilePage
// node whose mainEntity points at the canonical Person (defined in BaseLayout).
// dateModified is the static-build timestamp — honest, regenerated each build.
const profilePageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  dateModified: new Date().toISOString(),
  mainEntity: { '@id': 'https://andreassonphoto.com/#person' },
};
---

<BaseLayout title="Andrèasson Photo — Words" description="Finding beauty in what at first glance slipped quietly by">
  <script type="application/ld+json" is:inline set:html={JSON.stringify(profilePageSchema)} slot="head" />
  <main class="page-content">
    <h1 class="sr-only">Words</h1>
    <p class="invocation">
      In the name of God,<br>
      the Most Gracious, the Most Merciful.
    </p>
    <div class="verse">
      <p>
        Our gaze is drawn instinctively<br>
        to bright colours, bold contrasts,<br>
        and all that places itself<br>
        at the centre.
      </p>
      <p>
        But is this truly what is beautiful?
      </p>
      <p>
        Perhaps, if we take the time<br>
        to look beyond the obvious,<br>
        we find beauty in what at first glance<br>
        slipped quietly by.
      </p>
      <p>
        And if we can do this,<br>
        we need not climb the hilltop<br>
        nor travel to distant lands<br>
        to find the beautiful.<br>
        We may discover it here,<br>
        close by, right here.
      </p>
    </div>
    <p class="about-signature">
      Jonas Yu&#x0304;nus Andr&egrave;asson
    </p>
  </main>
</BaseLayout>
