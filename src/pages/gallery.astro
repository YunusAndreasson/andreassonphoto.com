---
import BaseLayout from '../layouts/BaseLayout.astro';
import GalleryView from '../components/GalleryView.astro';
import '../styles/global.css';
import images from '../content/gallery/images.json';

const allImages = [...images].sort((a, b) => a.order - b.order);
---

<BaseLayout title="Andreasson Photo — Gallery">
  <GalleryView images={allImages} />
</BaseLayout>
