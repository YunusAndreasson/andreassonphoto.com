---
import BaseLayout from '../layouts/BaseLayout.astro';
import GalleryView from '../components/GalleryView.astro';
import { getCollection } from 'astro:content';

const allImages = (await getCollection('gallery'))
  .map((entry) => entry.data)
  .sort((a, b) => a.order - b.order);
---

<BaseLayout
  title="Yunus Andreasson — Black-and-White Landscape Photography"
  description="Black-and-white photographs by Yunus Andreasson — quiet observations of landscape, light, and the beauty that at first glance slips quietly by."
>
  <GalleryView images={allImages} />
</BaseLayout>
