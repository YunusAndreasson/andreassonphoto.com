---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { AVIF_QUALITY } from '../utils/gallery';
import { CONTENT_W, GAP, wallSizes } from '../utils/layout';
import { PERSON_NAME, collectionPageSchema, pageTitle } from '../utils/site';

// The websites Yunus makes alongside the photography. This is the single page
// every site links back to ("Made by Yunus Andreasson"), so the sites
// themselves stay uncluttered — the full list lives here, not in each site.
const collectionSchema = collectionPageSchema('/code/', `Code — ${PERSON_NAME}`);

// The sites in page order, each with a screenshot of its front page
// (scripts/capture-sites.mjs retakes them).
const sites = (await getCollection('code'))
  .map((entry) => entry.data)
  .sort((a, b) => a.order - b.order);

// Two prints to a row on the wall, one on a phone. Requested widths are the
// column at 1x, 1.5x and 2x, plus the full 1440px screenshot.
const column = Math.round((CONTENT_W - GAP) / 2);
const printSizes = wallSizes(column);
const printWidths = [column, Math.round(column * 1.5), column * 2, 1440];
---

<BaseLayout preloadProse title={pageTitle('Code')} description={`Code by ${PERSON_NAME}, most of it for the web: sites for prayer and reading, the news, a town in Kosovo and the birds of Markaryd.`}
  ogImage="/og/code.jpg"
  ogImageAlt="zuhd.news hung in black and white beside the words: I also write code, mostly for the web.">
  <script type="application/ld+json" is:inline set:html={JSON.stringify(collectionSchema)} slot="head" />
  <main id="main-content" class="page-content code" tabindex="-1">
    <h1 class="sr-only">Code</h1>
    <p class="invocation">
      I also write code,<br>
      mostly for the web.<br>
      A few sites for prayer and reading.<br>
      One for the news, one for a town in Kosovo,<br>
      and one for the birds of Markaryd.
    </p>

    {/* Each site hangs as a print: in black and white on the wall, in its
        own colours when you reach for it. */}
    <ul class="code-wall">
      {sites.map((site, i) => (
        <li id={site.id}>
          <a class:list={['code-print', i < 2 && 'is-early']} href={site.url} rel="noopener noreferrer" target="_blank">
            <span class="code-frame">
              <Image
                src={site.image}
                alt=""
                widths={printWidths}
                sizes={printSizes}
                format="avif"
                quality={AVIF_QUALITY}
                priority={i < 2}
              />
            </span>
            <span class="code-name">{new URL(site.url).hostname}</span>
            <span class="code-desc">{site.desc}</span>
            <span class="sr-only"> (opens in a new tab)</span>
          </a>
        </li>
      ))}
    </ul>
  </main>

  <script>
    let controller: AbortController;

    document.addEventListener('astro:page-load', () => {
      controller?.abort();
      const prints = document.querySelectorAll<HTMLElement>('.code-print');
      if (!prints.length) return;
      controller = new AbortController();

      // The same scroll-in reveal as the gallery prints (see GalleryView).
      const reveal = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-visible');
          reveal.unobserve(entry.target);
        }
      }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
      for (const el of prints) if (!el.classList.contains('is-early')) reveal.observe(el);

      // A touch screen never hovers, so there the site nearest the middle of
      // the screen takes its colours, one at a time, the way the poem at the
      // reading line holds full strength on /poems: a band left two lit at
      // once more often than not. Prints level in a row light together. The
      // CSS applies this only where hover is unavailable.
      const touch = matchMedia('(hover: none)');
      const frames = Array.from(prints, (print) => print.querySelector<HTMLElement>('.code-frame')!);
      let lit: HTMLElement[] = [];
      let queued = false;

      const light = (next: HTMLElement[]) => {
        for (const print of lit) if (!next.includes(print)) print.classList.remove('is-lit');
        for (const print of next) print.classList.add('is-lit');
        lit = next;
      };

      const update = () => {
        queued = false;
        if (!touch.matches) return light([]);
        // A link to one site (/code/#zuhd-news) keeps it lit while it is
        // whole on the screen, though it lands near the top.
        const target = frames.findIndex((frame) => frame.closest('li')!.matches(':target'));
        if (target >= 0) {
          const { top, bottom } = frames[target].getBoundingClientRect();
          if (top >= 0 && bottom <= window.innerHeight) return light([prints[target]]);
        }
        const middle = window.innerHeight / 2;
        const distances = frames.map((frame) => {
          const { top, bottom } = frame.getBoundingClientRect();
          return Math.abs((top + bottom) / 2 - middle);
        });
        const nearest = Math.min(...distances);
        light([...prints].filter((_, i) => distances[i] - nearest < 1));
      };

      const queue = () => {
        if (!queued) requestAnimationFrame(update);
        queued = true;
      };

      update();
      window.addEventListener('scroll', queue, { passive: true, signal: controller.signal });
      window.addEventListener('resize', queue, { passive: true, signal: controller.signal });
      touch.addEventListener('change', queue, { signal: controller.signal });

      controller.signal.addEventListener('abort', () => {
        reveal.disconnect();
      });
    });
  </script>
</BaseLayout>
