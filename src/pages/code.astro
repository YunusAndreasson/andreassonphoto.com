---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { AVIF_QUALITY } from '../utils/gallery';
import { CONTENT_W, GAP, PHONE_MAX, WALL_MAX } from '../utils/layout';
import { PERSON_NAME, collectionPageSchema, pageTitle } from '../utils/site';

// The websites Yunus makes alongside the photography. This is the single page
// every site links back to ("Made by Yunus Andreasson"), so the sites
// themselves stay uncluttered — the full list lives here, not in each site.
const collectionSchema = collectionPageSchema('/code/', `Code — ${PERSON_NAME}`);

// The sites in page order, each with a screenshot of its front page
// (scripts/capture-sites.mjs retakes them).
const sites = (await getCollection('code'))
  .map((entry) => entry.data)
  .sort((a, b) => a.order - b.order);

// Two prints to a row on the wall, one on a phone. Requested widths are the
// column at 1x, 1.5x and 2x, plus the full 1440px screenshot.
const column = Math.round((CONTENT_W - GAP) / 2);
const printSizes = `(width <= ${PHONE_MAX}px) 100vw, (width <= ${WALL_MAX}px) 50vw, ${column}px`;
const printWidths = [column, Math.round(column * 1.5), column * 2, 1440];
---

<BaseLayout preloadProse title={pageTitle('Code')} description={`Code by ${PERSON_NAME}, most of it websites: prayer times, Islamic texts, Arabic, the news, a guide to Gjakova, and birdwatching in Markaryd.`}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(collectionSchema)} slot="head" />
  <main id="main-content" class="page-content code" tabindex="-1">
    <h1 class="sr-only">Code</h1>
    <p class="invocation">
      When I’m not out with the camera,<br>
      I write code, most of it for the web.<br>
      A few sites for prayer and reading,<br>
      one for the news, one for a town in Kosovo,<br>
      and one for the birds of Markaryd.
    </p>

    <!-- Each site hangs as a print: in black and white on the wall, in its
         own colours when you reach for it. -->
    <ul class="code-wall">
      {sites.map((site, i) => (
        <li>
          <a class:list={['code-print', i < 2 && 'is-early']} href={site.url} rel="noopener noreferrer" target="_blank">
            <span class="code-frame">
              <Image
                src={site.image}
                alt=""
                widths={printWidths}
                sizes={printSizes}
                format="avif"
                quality={AVIF_QUALITY}
                loading={i < 2 ? 'eager' : 'lazy'}
              />
            </span>
            <span class="code-name">{new URL(site.url).hostname}</span>
            <span class="code-desc">{site.desc}</span>
            <span class="sr-only"> (opens in a new tab)</span>
          </a>
        </li>
      ))}
    </ul>
  </main>

  <script>
    let controller: AbortController;

    document.addEventListener('astro:page-load', () => {
      controller?.abort();
      const prints = document.querySelectorAll<HTMLElement>('.code-print');
      if (!prints.length) return;
      controller = new AbortController();

      // The same scroll-in reveal as the gallery prints (see GalleryView).
      const reveal = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-visible');
          reveal.unobserve(entry.target);
        }
      }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
      for (const el of prints) if (!el.classList.contains('is-early')) reveal.observe(el);

      // A touch screen never hovers, so there a site takes its colours while
      // it crosses the middle third of the screen and gives them back as it
      // leaves. The CSS applies this only where hover is unavailable.
      const lit = new IntersectionObserver((entries) => {
        for (const entry of entries) entry.target.classList.toggle('is-lit', entry.isIntersecting);
      }, { rootMargin: '-33% 0px -33% 0px' });
      for (const el of prints) lit.observe(el);

      controller.signal.addEventListener('abort', () => {
        reveal.disconnect();
        lit.disconnect();
      });
    });
  </script>
</BaseLayout>
