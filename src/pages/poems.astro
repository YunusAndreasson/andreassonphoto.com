---
import BaseLayout from '../layouts/BaseLayout.astro';
import PoemBody from '../components/PoemBody.astro';
import { PERSON_NAME, pageTitle } from '../utils/site';
import { getCollection } from 'astro:content';
import { getPoems, month } from '../utils/poems';

// The pieces from the diaries, newest first, gathered under their year the way
// /birds gathers species under their family.
const pieces = await getPoems();

// Each year carries its title, a line from its own pieces, where it has one.
const titles = new Map((await getCollection('poemYears')).map((entry) => [entry.data.id, entry.data.title]));

const years: { year: string; title?: string; pieces: typeof pieces }[] = [];
for (const piece of pieces) {
  const year = piece.date.slice(0, 4);
  let group = years.find((y) => y.year === year);
  if (!group) {
    group = { year, title: titles.get(year), pieces: [] };
    years.push(group);
  }
  group.pieces.push(piece);
}

const first = pieces.at(-1)!.date.slice(0, 4);
const last = pieces[0].date.slice(0, 4);
---

<BaseLayout
  preloadProse
  title={pageTitle('Poems')}
  description={`Poems from ${PERSON_NAME}’s diaries, ${first} to ${last}.`}
  ogImage="/og/poems.jpg"
  ogImageAlt="The poem Swifts, July 2025: Swifts teasing the falling dark, going nowhere, never still."
>
  <main id="main-content" class="page-content poems" tabindex="-1">
    <h1 class="sr-only">Poems</h1>
    <p class="invocation">
      In the name of Allāh,<br>
      the Most Gracious, the Most Merciful.
    </p>
    <p class="poems-note">
      Poems from my diaries, {first} to {last}, most of them first written in Swedish.
    </p>

    {years.map(({ year, title, pieces }) => (
      <section class="poems-year" id={`y${year}`} aria-labelledby={`y${year}-label`}>
        <header class="poems-year-head">
          <h2 class="poems-year-label" id={`y${year}-label`}>{year}</h2>
          {title && <p class="poems-year-title">{title}</p>}
        </header>
        <div class="poems-year-pieces">
          {pieces.map((piece) => (
            <article class="poem" id={piece.id}>
              <h3 class="poem-title"><a href={`/poems/${piece.id}/`}>{piece.title}</a></h3>
              <p class="poem-date">
                <time datetime={piece.date}>{month(piece.date)}<span class="poem-date-year"> {year}</span></time>
              </p>
              <PoemBody piece={piece} />
            </article>
          ))}
        </div>
      </section>
    ))}
  </main>

  <script>
    let controller: AbortController;

    document.addEventListener('astro:page-load', () => {
      controller?.abort();
      // The poem nearest the reading line, two fifths down the window, is the
      // one being read; the rest step back until the reader reaches them.
      // Where CSS can tie the fade to the scroll itself, it does this alone.
      const main = document.querySelector<HTMLElement>('main.poems');
      if (!main || CSS.supports('animation-timeline: view()')) return;
      controller = new AbortController();

      const poems = Array.from(main.querySelectorAll<HTMLElement>('.poem'));
      let current: HTMLElement | undefined;
      let queued = false;

      const update = () => {
        queued = false;
        const line = window.innerHeight * 0.4;
        let nearest: HTMLElement | undefined;
        let distance = Infinity;
        for (const poem of poems) {
          const { top, bottom } = poem.getBoundingClientRect();
          const d = top > line ? top - line : bottom < line ? line - bottom : 0;
          if (d < distance) [nearest, distance] = [poem, d];
          if (top > line) break; // in page order, so the rest are further away
        }
        if (nearest === current) return;
        current?.classList.remove('is-current');
        nearest?.classList.add('is-current');
        current = nearest;
      };

      const queue = () => {
        if (!queued) requestAnimationFrame(update);
        queued = true;
      };

      update();
      main.dataset.focus = '';
      window.addEventListener('scroll', queue, { passive: true, signal: controller.signal });
      window.addEventListener('resize', queue, { passive: true, signal: controller.signal });
    });
  </script>
</BaseLayout>
