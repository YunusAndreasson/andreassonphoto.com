---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PERSON_NAME, collectionPageSchema, pageTitle } from '../utils/site';
import { getCollection } from 'astro:content';

// The Sweden list, set as museum labels rather than a spreadsheet: every species
// Yunus has seen in Sweden, in taxonomic order, grouped by family. The Förekomst
// code that came with the list is kept as `regular` — so the page can quietly
// mark which of these were the rarities rather than the residents.
const species = (await getCollection('birds'))
  .map((entry) => entry.data)
  .sort((a, b) => a.order - b.order);

const total = species.length;
const rarities = species.filter((b) => !b.regular).length;

// Families in order of first appearance; species keep their list order within.
const groups: { name: string; birds: typeof species; rare: number }[] = [];
for (const bird of species) {
  let group = groups.find((g) => g.name === bird.group);
  if (!group) {
    group = { name: bird.group, birds: [], rare: 0 };
    groups.push(group);
  }
  group.birds.push(bird);
  if (!bird.regular) group.rare += 1;
}

// Anchors for linking straight to a family or a bird: "Herons, Storks &
// Ibises" → herons-storks-ibises; a bird keeps its id, the Latin name.
const slug = (name: string) => name.toLowerCase().replace(/[^a-z]+/g, '-').replace(/^-|-$/g, '');

// The few birds that appear elsewhere on the site. Most were gone before the
// camera was up, so the list is names; these open onto where they stayed.
const elsewhere: Record<string, { href: string; label: string }> = {
  'cygnus-cygnus': { href: '/whooper-swan/', label: 'In a photograph' },
  'apus-apus': { href: '/poems/swifts/', label: 'In a poem' },
};

const collectionSchema = collectionPageSchema(
  '/birds/',
  `Birds — ${PERSON_NAME}`,
  `Every bird species ${PERSON_NAME} has seen in Sweden, ${total} so far.`,
);
---

<BaseLayout preloadProse
  title={pageTitle('Birds')}
  description={`Every bird species ${PERSON_NAME} has seen in Sweden: ${total} so far, ${rarities} of them rarities.`}
  ogImage="/og/birds.jpg"
  ogImageAlt={`Whooper Swan, a black-and-white photograph by ${PERSON_NAME}, beside the words: Every bird I have seen in Sweden. ${total} seen in Sweden.`}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(collectionSchema)} slot="head" />
  <main id="main-content" class="page-content" tabindex="-1">
    <h1 class="sr-only">Birds</h1>
    <p class="invocation">
      Every bird I have seen in Sweden.<br>
      Most of them heard before they were seen,<br>
      and gone before the camera was up.<br>
      So I keep them here instead, as names.
    </p>

    <section class="bird-tally" aria-label="Tally">
      <div class="bird-tally-cell">
        <span class="bird-tally-figure">{total}</span>
        <span class="bird-tally-caption">Seen in Sweden</span>
      </div>
      <div class="bird-tally-cell">
        <span class="bird-tally-figure">{groups.length}</span>
        <span class="bird-tally-caption">Families</span>
      </div>
      <div class="bird-tally-cell">
        <span class="bird-tally-figure">{rarities}</span>
        <span class="bird-tally-caption">Rarities</span>
      </div>
    </section>

    <div class="bird-toggle">
      <label class="bird-toggle-label" for="rarities-only">
        <input type="checkbox" id="rarities-only" class="sr-only" />
        <span class="bird-toggle-dot" aria-hidden="true"></span>
        <span>Show only the {rarities} rarities</span>
      </label>
      <p class="bird-legend">Birds that stray to Sweden, rather than live here.</p>
    </div>

    <div class="bird-ledger">
      {groups.map((group) => (
        <section class="bird-group" id={slug(group.name)} style={`--n:${group.birds.length}`}>
          <h2 class="section-label">
            {group.name.split(' & ').map((part, i) => (i ? <>{' '}<span class="amp">&amp;</span>{' '}{part}</> : part))}<span class="sr-only">, </span>
            <span class="bird-group-count">
              <span class="bird-count-all">{group.birds.length}<span class="sr-only"> species</span></span>
              <span class="bird-count-rare">{group.rare}<span class="sr-only"> rarities</span></span>
            </span>
          </h2>
          <ul class="bird-list">
            {group.birds.map((bird) => (
              <li class:list={['bird', { 'is-rare': !bird.regular }]} id={bird.id}>
                <span class="bird-sv" lang="sv">{bird.sv}{!bird.regular && <span class="sr-only" lang="en"> (a rarity)</span>}</span>
                <span class="bird-meta">{bird.en.replaceAll("'", '’')}<i lang="la">{bird.la}</i></span>
                {elsewhere[bird.id] && <a class="bird-elsewhere" href={elsewhere[bird.id].href}>{elsewhere[bird.id].label}</a>}
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <p class="bird-source">
      Names and order follow the Swedish list. An open circle marks a rarity.
    </p>
  </main>
</BaseLayout>
