# Cloudflare Pages Headers

# Astro hashed assets (incl. Fonts API files) - cache forever
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Open Graph image - cache 30 days
/og/*
  Cache-Control: public, max-age=2592000

# Pages already revalidates HTML by default. Do not put Cache-Control on
# this catch-all: matching values are joined, conflicting with immutable fonts.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
