{
  "name": "andreassonphoto",
  "private": true,
  "description": "Black-and-white photographs by Jonas Yūnus Andrèasson, mostly of landscapes and the small things people walk past.",
  "homepage": "https://andreassonphoto.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YunusAndreasson/andreassonphoto.git"
